<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <template id="book_details_topbar" name="Book Deatils Topbar">
            <nav class="navbar navbar-light border-top shadow-sm d-print-none">
                <div class="container align-items-baseline justify-content-between">
                    <a href="/library" class="navbar-brand h4 my-0 me-0 me-md-4">
                        <i class="fa fa-long-arrow-left me-2"/>
                        <span>All Books</span>
                    </a>
                    <div class="d-flex align-items-centerflex-wrap ps-sm-3 pe-0">
                        <t t-call="lms_website_book.library_search_box_input">
                            <t t-set="_classes" t-valuef="ms-auto"/>
                        </t>
                    </div>
                </div>
            </nav>
        </template>

        <!-- Template to render when a book is clicked. -->
        <template id="book_details" name="Each Book Details">
            <t t-call="website.layout">
                <t t-call="lms_website_book.book_details_topbar"/>
                <section class="details_section o_cc o_cc2 pt24 pb24">
                    <div class="container">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-md-5 text-center p-2">
                                <h1 class="o_page_header mt8">
                                    <span t-field="book_details.name"/>
                                </h1>
                                <div class="p-2">
                                    <t t-if="book_details.image">
                                        <img t-att-src="image_data_uri(book_details.image)" class="img-fluid img-thumbnail" t-att-alt="book_details.name" />
                                    </t>
                                    <t t-else="">
                                        <span t-field="book_details.image" t-options="{'widget': 'image', 'class': 'img-fluid rounded'}"/>
                                    </t>
                                </div>
                            </div>
                            <t t-call="lms_website_book.book_details_accordion"/>
                        </div>
                    </div>
                </section>
            </t>
        </template>

        <template id="book_details_accordion">
            <div class="col-md-5 p-2">
                <div class="accordion" id="book-accordion">
                    <t t-foreach="accordion_items" t-as="item">
                        <div class="accordion-item">
                            <h2 class="accordion-header" t-attf-id="#{item['id']}_header">
                                <button t-attf-class="accordion-button #{'collapsed' if not item['expanded'] else ''}" type="button" data-bs-toggle="collapse" t-attf-data-bs-target="##{item['id']}" t-attf-aria-expanded="#{'true' if item['expanded'] else 'false'}" t-attf-aria-controls="#{item['id']}">
                                    <b>
                                        <t t-esc="item['title']"/>
                                    </b>
                                </button>
                            </h2>
                            <div t-attf-id="#{item['id']}" t-attf-class="accordion-collapse collapse #{'show' if item['expanded'] else ''}" t-attf-aria-labelledby="#{item['id']}_header" data-bs-parent="#book-accordion">
                                <div class="accordion-body">
                                    <t t-call="#{item['template']}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </template>

        <!-- Template that renders the clicked book's details. -->
        <template id="lms_book_information" name="Book Details">
            <section class="lms_book_details_section">
                <table class="table table-striped table-sm table-hover" id="lms_book_details_table">
                    <tbody>
                        <tr class="text-center">
                            <td>
                                <strong>Author</strong>
                            </td>
                            <td>:</td>
                            <td>
                                <t t-if="book_details.author_ids">
                                    <t t-foreach="book_details.author_ids" t-as="author">
                                        <span t-field="author.name" />
                                        <span t-if="author != book_details.author_ids[-1]">, </span>
                                    </t>
                                </t>
                                <t t-else="" class="alert alert-warning">
                                    <span>No author specified.</span>
                                </t>
                            </td>
                        </tr>
                        <tr class="text-center">
                            <td>
                                <strong>Genre</strong>
                            </td>
                            <td>:</td>
                            <td>
                                <t t-if="book_details.genre_ids">
                                    <t t-foreach="book_details.genre_ids" t-as="genre">
                                        <span t-field="genre.name" />
                                        <span t-if="genre != book_details.genre_ids[-1]">, </span>
                                    </t>
                                </t>
                                <t t-else="" class="alert alert-warning">
                                    <span>No genre specified.</span>
                                </t>
                            </td>
                        </tr>
                        <tr class="text-center">
                            <td>
                                <strong>ISBN</strong>
                            </td>
                            <td>:</td>
                            <td>
                                <t t-if="book_details.isbn != 0">
                                    <span t-field="book_details.isbn" />
                                </t>
                                <t t-else="" class="alert alert-warning">
                                    <span>No ISBN specified.</span>
                                </t>
                            </td>
                        </tr>
                        <tr class="text-center">
                            <td>
                                <strong>Language</strong>
                            </td>
                            <td>:</td>
                            <td>
                                <t t-if="book_details.language_id">
                                    <span t-field="book_details.language_id" />
                                </t>
                                <t t-else="" class="alert alert-warning">
                                    <span>No language specified.</span>
                                </t>
                            </td>
                        </tr>
                        <tr class="text-center">
                            <td>
                                <strong>Country</strong>
                            </td>
                            <td>:</td>
                            <td>
                                <t t-if="book_details.country_id">
                                    <span t-field="book_details.country_id" />
                                </t>
                                <t t-else="" class="alert alert-warning">
                                    <span>No country specified.</span>
                                </t>
                            </td>
                        </tr>
                        <tr class="text-center">
                            <td>
                                <strong>Price</strong>
                            </td>
                            <td>:</td>
                            <td class="text-center table-responsivetd-price">
                                <t t-if="book_details.price > 0.00">
                                    <span t-field="book_details.price" />
                                </t>
                                <t t-else="" class="alert alert-warning">
                                    <span>No price specified.</span>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </template>

        <template id="lms_book_additional_details" name="Additional Book Details">
            <section class="additional_details_section">
                <div class="additional-details-container">
                    <table class="table table-striped table-sm table-hover">
                        <tbody>
                            <tr class="text-center">
                                <td>
                                    <strong>Publisher</strong>
                                </td>
                                <td>:</td>
                                <td>
                                    <t t-if="book_details.publisher_id">
                                        <span t-field="book_details.publisher_id.name" />
                                    </t>
                                    <t t-else="" class="alert alert-warning">
                                        <span>No publisher specified.</span>
                                    </t>
                                </td>
                            </tr>
                            <tr class="text-center">
                                <td>
                                    <strong>Shelf</strong>
                                </td>
                                <td>:</td>
                                <td>
                                    <t t-if="book_details.shelf_id">
                                        <span t-field="book_details.shelf_id.name" />
                                    </t>
                                    <t t-else="" class="alert alert-warning">
                                        <span>No shelf specified.</span>
                                    </t>
                                </td>
                            </tr>
                            <tr class="text-center">
                                <td>
                                    <strong>Date Published</strong>
                                </td>
                                <td>:</td>
                                <td>
                                    <t t-if="book_details.date_published">
                                        <span t-field="book_details.date_published" />
                                    </t>
                                    <t t-else="" class="alert alert-warning">
                                        <span>No published date specified.</span>
                                    </t>
                                </td>
                            </tr>
                            <tr class="text-center">
                                <td>
                                    <strong>Edition</strong>
                                </td>
                                <td>:</td>
                                <td>
                                    <t t-if="book_details.edition">
                                        <span t-field="book_details.edition" />
                                    </t>
                                    <t t-else="" class="alert alert-warning">
                                        <span>No edition specified.</span>
                                    </t>
                                </td>
                            </tr>
                            <tr class="text-center">
                                <td>
                                    <strong>Total Pages</strong>
                                </td>
                                <td>:</td>
                                <td>
                                    <t t-if="book_details.pages">
                                        <span t-field="book_details.pages" />
                                    </t>
                                    <t t-else="" class="alert alert-warning">
                                        <span>No pages specified.</span>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </template>

        <template id="lms_book_author_details" name="Author Details">
            <t t-if="book_details.author_ids">
                <section class="author_details_section o_cc o_cc2 pt24 pb24">
                    <div class="author_details_container">
                        <table class="table table-striped table-sm table-hover">
                            <tbody>
                                <div class="pt-3 pt-lg-0" t-if="len(book_details.author_ids) &gt; 1">
                                    <tr class="text-center">
                                        <td>
                                            <strong>Name</strong>
                                        </td>
                                        <td>
                                            <strong>Country</strong>
                                        </td>
                                        <td>
                                            <strong>Language</strong>
                                        </td>
                                        <td>
                                            <strong>Total Books In Our Library</strong>
                                        </td>
                                    </tr>
                                    <tr class="text-center" t-foreach="book_details.author_ids" t-as="author">
                                        <td>
                                            <strong>
                                                <span t-field="author.name" />
                                            </strong>
                                        </td>
                                        <td>
                                            <span t-field="author.country_id.name" />
                                        </td>
                                        <td>
                                            <span t-field="author.language_id.name" />
                                        </td>
                                        <td>
                                            <span t-field="author.book_count" />
                                        </td>
                                    </tr>
                                </div>
                                <div t-else="">
                                    <tr class="text-center">
                                        <td>
                                            <strong>Name</strong>
                                        </td>
                                        <td>:</td>
                                        <td>
                                            <span t-field="book_details.author_ids.name" />
                                        </td>
                                    </tr>
                                    <tr class="text-center">
                                        <td>
                                            <strong>Country</strong>
                                        </td>
                                        <td>:</td>
                                        <td>
                                            <span t-field="book_details.author_ids.country_id.name" />
                                        </td>
                                    </tr>
                                    <tr class="text-center">
                                        <td>
                                            <strong>Language</strong>
                                        </td>
                                        <td>:</td>
                                        <td>
                                            <span t-field="book_details.author_ids.language_id.name" />
                                        </td>
                                    </tr>
                                    <tr class="text-center">
                                        <td>
                                            <strong>Total Books In Our Library</strong>
                                        </td>
                                        <td>:</td>
                                        <td>
                                            <span t-field="book_details.author_ids.book_count" />
                                        </td>
                                    </tr>
                                </div>
                            </tbody>
                        </table>
                    </div>
                </section>
            </t>
            <t t-else="" class="alert alert-warning">
                <span>No author provided.</span>
            </t>
        </template>

        <!-- Top Books Accordion Item -->
        <template id="lms_author_top_books" name="Author Top Books">
            <ul t-if="top_book_list">
                <t t-foreach="top_book_list" t-as="book">
                    <li>
                        <div>
                            <a class="btn btn-link" t-att-href="'/library/book/%d' % book.get('id')">
                                <span t-if="book.get('name')">
                                    <t t-esc="book['name']"/>
                                </span>
                            </a>
                        </div>
                    </li>
                </t>
            </ul>
            <span t-else="" class="alert alert-warning">No books</span>
        </template>

        <!-- Synopsis Accordion Item-->
        <template id="lms_book_synopsis" name="Book Synopsis">
            <t t-if="book_details.description">
                <span t-field="book_details.description" />
            </t>
            <t t-else="" class="alert alert-warning">
                <span>No synopsis/description provided.</span>
            </t>
        </template>
    </data>
</odoo>
