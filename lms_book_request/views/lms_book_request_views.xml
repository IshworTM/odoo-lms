<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="lms_book_request_view_search" model="ir.ui.view">
            <field name="name">lms.book.request.view.search</field>
            <field name="model">lms.book.request</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="genre" />
                    <field name="author" />
                    <field name="language" />
                    <field name="publisher" />
                    <field name="price" />
                </search>
            </field>
        </record>

        <record id="lms_book_request_view_kanban" model="ir.ui.view">
            <field name="name">lms.book.request.view.kanban</field>
            <field name="model">lms.book.request</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top mb-0">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <div class="d-flex justify-content-between">
                                                    <t t-if="record.name.raw_value">
                                                        <field name="name"/>
                                                    </t>
                                                </div>
                                            </strong>
                                        </div>
                                    </div>
                                    <t t-if="record.genre.value">
                                        <div name="book_genre">
                                            <strong>Genre: </strong>
                                            <field name="genre"/>
                                        </div>
                                    </t>
                                    <t t-if="record.author.value">
                                        <div name="book_authors" class="mt-1">
                                            <strong>Author: </strong>
                                            <field name="author"/>
                                        </div>
                                    </t>
                                    <t t-if="record.price.raw_value">
                                        <div name="book_price">
                                            <strong>MRP: </strong>
                                            <field name="price" widget="monetary"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="lms_book_request_view_tree" model="ir.ui.view">
            <field name="name">lms.book.request.view.tree</field>
            <field name="model">lms.book.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="genre" />
                    <field name="author" />
                    <field name="language" />
                    <field name="publisher" />
                    <field name="price" />
                </tree>
            </field>
        </record>

        <record id="lms_book_request_view_form" model="ir.ui.view">
            <field name="name">lms.book.request.view.form</field>
            <field name="model">lms.book.request</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="genre" />
                            <field name="author" />
                            <field name="language" />
                            <field name="publisher" />
                            <field name="price" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lms_book_request_action" model="ir.actions.act_window">
            <field name="name">Book Requests</field>
            <field name="res_model">lms.book.request</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <menuitem id="lms_book_request_menu" name="Book Requests" parent="va_lms.lms_root_menu" action="lms_book_request_action" sequence="6"/>
    </data>
</odoo>
