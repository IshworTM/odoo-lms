<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lms_member_tree_view" model="ir.ui.view">
        <field name="name">lms.member.tree.view</field>
        <field name="model">lms.member</field>
        <field name="arch" type="xml">
            <tree string="Members">
                <field name="display_name" />
                <field name="unique_id" />
                <field name="member_name" />
                <field name="address" />
                <field name="phone_no" />
                <field name="date_of_birth" />
                <field name="email" widget="email" />
                <field name="membership_type" />
                <field name="issued_date" />
                <field name="expiry_date" />
                <field name="membership_price" />
                <field name="payment_status" widget="badge" decoration-danger="payment_status == 'unpaid'" decoration-warning="payment_status == 'partially_paid'" decoration-success="payment_status == 'paid'"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="lms_member_kanban_view">
        <field name="name">lms.member.kanban</field>
        <field name="model">lms.member</field>
        <field name="arch" type="xml">
            <kanban string="members" sample="1">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="image" preview_image="image" widget="image" options="{'zoom': true, 'zoom_delay': 1000}" />
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <div class="d-flex justify-content-between">
                                                <t t-if="record.display_name.raw_value">
                                                    <field name="display_name" />
                                                </t>
                                            </div>
                                        </strong>
                                    </div>
                                </div>
                                <div name="unique_id_container" class="mt-1">
                                    <t t-if="record.unique_id.value">
                                        <span>
                                            <strong>ID: </strong>
                                        </span>
                                        <field name="unique_id"/>
                                    </t>
                                </div>
                                <div name="member_email" class="mt-1">
                                    <t t-if="record.email.value">
                                        <field name="email" widget="email"/>
                                    </t>
                                </div>
                                <div name="member_address">
                                    <t t-if="record.address.value">
                                        <span>
                                            <strong>Address: </strong>
                                        </span>
                                        <field name="address"/>
                                    </t>
                                </div>
                                <div name="member_issued_date" class="mt-1">
                                    <t t-if="record.issued_date.value">
                                        <span>
                                            <strong>Issued Date: </strong>
                                        </span>
                                        <field name="issued_date" />
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="lms_member_form_view" model="ir.ui.view">
        <field name="name">lms.member.form.view</field>
        <field name="model">lms.member</field>
        <field name="arch" type="xml">
            <form string="Members">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="d-flex">
                        <field name="image" widget="image" class="oe_avatar" options="{'size': [120, 120]}" />
                        <div class="oe_title col-6 m-4">
                            <label for="unique_id"/>
                            <h3>
                                <field name="unique_id" />
                            </h3>
                            <label for="member_name"/>
                            <h1>
                                <field name="member_name" placeholder="Name" />
                            </h1>
                            <label for="partner_id"/>
                            <field name="partner_id" readonly="1" />
                        </div>
                    </div>
                    <group>
                        <group name="general_information" string="General Information">
                            <field name="company_currency_id" invisible="1" />
                            <field name="address" />
                            <field name="phone_no" />
                            <field name="date_of_birth" />
                            <field name="email" widget="email" />
                        </group>
                        <group name="membership_information" string="Membership Information">
                            <field name="membership_type" />
                            <field name="membership_price" widget="monetary" />
                            <field name="payment_status" />
                            <field name="partially_paid_amount" widget="monetary" attrs="{'invisible':[('payment_status','!=','partially_paid')],'required':[('payment_status','!=','partially_paid')]}" />
                            <field name="issued_date" />
                            <field name="expiry_date" />
                        </group>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="lms_member_view_search" model="ir.ui.view">
        <field name="name">lms.member.view.search</field>
        <field name="model">lms.member</field>
        <field name="arch" type="xml">
            <search string="member">
                <filter name="payment_status_unpaid" string="Unpaid" domain="['|',('payment_status', '=', 'unpaid'), ('payment_status', '=', 'partially_paid')]" />
                <separator/>
                <filter name="payment_status_paid" string="Paid" domain="[ ('payment_status', '=', 'paid')]" />
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                <field name="member_name" />
                <field name="unique_id" />
            </search>
        </field>
    </record>

    <record id="lms_member_action" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">lms.member</field>
        <field name="view_mode">kanban,tree,form</field>

    </record>

    <menuitem id="lms_member_menu" name="Members" parent="va_lms.lms_root_menu" action="lms_member_action" sequence="5"/>
</odoo>
