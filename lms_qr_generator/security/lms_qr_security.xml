<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="lms_qr_access_control">
        <field name="name">LMS QR</field>
        <field name="description">LMS QR Access</field>
        <field name="sequence">11</field>
    </record>
    <record id="group_able_to_create_qr" model="res.groups">
        <field name="name">Able to create QR</field>
        <field name="comment">The user who can create QR</field>
        <field name="category_id" ref="lms_qr_access_control" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
    <record id="group_able_to_read_qr" model="res.groups">
        <field name="name">Able to Read QR</field>
        <field name="comment">The user who can Read QR</field>
        <field name="category_id" ref="lms_qr_access_control" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
    <record id="group_able_to_delete_qr" model="res.groups">
        <field name="name">Able to delete QR</field>
        <field name="comment">The user who can delete QR</field>
        <field name="category_id" ref="lms_qr_access_control" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
    <record id="group_able_to_update_qr" model="res.groups">
        <field name="name">Able to update QR</field>
        <field name="comment">The user who can update QR</field>
        <field name="category_id" ref="lms_qr_access_control" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
</odoo>
