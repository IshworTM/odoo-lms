<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="lms_qr_tree_view">
            <field name="name">lms.qr.tree</field>
            <field name="model">lms.qr</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="serial_no" />
                    <field name="qr_code" widget="image" options="{'size': [150, 150]}" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="lms_qr_form">
            <field name="name">lms.qr.form</field>
            <field name="model">lms.qr</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="serial_no"/>
                            <field name="qr_code" widget="image" options="{'size': [150, 150]}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lms_qr_print" model="ir.actions.report">
            <field name="name">Print QR</field>
            <field name="model">lms.qr</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">lms_qr_generator.print_lms_qr</field>
            <field name="report_file">lms_qr_generator.print_lms_qr</field>
            <field name="print_report_name">'QR - %s' % (object.serial_no)</field>
            <field name="binding_model_id" ref="model_lms_qr"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_qr_a3"/>
        </record>

        <template id="lms_qr_generator.print_lms_qr">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="qr">
                        <div style="margin:30px 30px; float: left; page-break-inside: avoid;" align="center">
                            <t t-esc="qr.qr_code" t-options="{'widget':'image'}"/>
                            <t t-if="qr.serial_no">
                                <p align="center" class="h6 fw-bold">
                                    <t t-esc="qr.serial_no"/>
                                </p>
                            </t>
                        </div>
                    </t>
                    <div style="clear:both" class="clear"></div>
                </div>
            </t>
        </template>

        <record model="ir.actions.act_window" id="lms_qr_code_action">
            <field name="name">Qr</field>
            <field name="res_model">lms.qr</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_qr_generator_id':1,'group_by':['qr_generator_id']}</field>
        </record>
        <menuitem id="lms_qr_view_menu" name="View QR" parent="lms_qr_menu" action="lms_qr_code_action"/>
    </data>
</odoo>
